{
  "name": "bbspos",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @bbspos/db generate",
    "db:migrate": "pnpm --filter @bbspos/db migrate",
    "db:seed": "pnpm --filter @bbspos/db seed",
    "daily-report": "pnpm --filter @bbspos/db daily-report",
    "telegram-alert": "pnpm --filter @bbspos/db telegram-alert",
    "rename-toppings": "pnpm --filter @bbspos/db rename-toppings",
    "db:sync": "scripts\\db-sync.bat",
    "setup-env": "node scripts/setup-env.mjs",
    "proxy": "node scripts/https-proxy/proxy.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "http-proxy": "^1.18.1",
    "sharp": "^0.35.4",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2"
  }
}
