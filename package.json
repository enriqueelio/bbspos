{
  "name": "bubba",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @bubba/db generate",
    "db:migrate": "pnpm --filter @bubba/db migrate",
    "db:seed": "pnpm --filter @bubba/db seed"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
