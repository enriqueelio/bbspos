generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  username         String      @unique
  name             String
  password         String
  role             Role        @default(CAJERO)
  shift            Shift       @default(SIN_TURNO)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  orders           Order[]
  cancelledOrders  Order[]     @relation("OrderCanceledBy")
  discountedOrders Order[]     @relation("OrderDiscountedBy")
  redeemedRewards  CustomerReward[] @relation("CustomerRewardRedeemedBy")
  cashCloses       CashClose[]
}

model Size {
  id          String       @id @default(cuid())
  name        String       @unique
  oz          Int
  available   Boolean      @default(true)
  isDefault   Boolean      @default(false)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  drinkPrices DrinkPrice[]
}

model Flavor {
  id         String               @id @default(cuid())
  name       String               @unique
  categories FlavorCategoryLink[]
  available  Boolean              @default(true)
  imageUrl   String?
  createdAt  DateTime             @default(now())
}

model FlavorCategoryLink {
  id        String         @id @default(cuid())
  flavorId  String
  flavor    Flavor         @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  category  FlavorCategory
  createdAt DateTime       @default(now())

  @@unique([flavorId, category])
}

model BobaType {
  id          String       @id @default(cuid())
  name        String       @unique
  kind        BobaKind
  available   Boolean      @default(true)
  isDefault   Boolean      @default(false)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  drinkPrices DrinkPrice[]
}

model DrinkPrice {
  id         String         @id @default(cuid())
  category   FlavorCategory
  sizeId     String
  size       Size           @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  bobaTypeId String
  bobaType   BobaType       @relation(fields: [bobaTypeId], references: [id], onDelete: Cascade)
  price      Int
  createdAt  DateTime       @default(now())

  @@unique([category, sizeId, bobaTypeId])
}

model Topping {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int
  available Boolean  @default(true)
  imageUrl  String?
  createdAt DateTime @default(now())
}

model MenuItem {
  id             String           @id @default(cuid())
  name           String
  category       MenuCategory     @default(ALMUERZO)
  price          Int
  description    String?
  available      Boolean          @default(true)
  enMenuDelDia   Boolean          @default(false)
  menuDelDiaDate String?
  imageUrl       String?
  // Alitas: true si el plato exige elegir salsas (Alitas Mixtas).
  isMixtas       Boolean          @default(false)
  // Salsas a elegir por defecto en las Alitas Mixtas (por plato).
  requiredSauces Int?
  options        MenuItemOption[]
  lunchQuotas    LunchQuota[]
  lunchHolds     LunchHold[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category, available])
}

// Opciones de un platillo con variantes de precio obligatorias, p. ej. las
// milanesas "a la carta" que se cobra distinto Pollo vs Res.
model MenuItemOption {
  id             String   @id @default(cuid())
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name           String
  price          Int
  // Alitas Mixtas: salsas a elegir para este tamaño (6/8 = 2, 12 = 3).
  requiredSauces Int?
  createdAt      DateTime @default(now())

  @@unique([menuItemId, name])
}

// Salsas disponibles para las Alitas Mixtas (catálogo administrable por admin).
model AlitaSauce {
  id        String   @id @default(cuid())
  name      String   @unique
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cuenta corriente de un cliente/pensionado. El saldo es Int (Bs, igual que el
// resto del sistema): positivo = saldo a favor (Prepago), negativo = deuda
// (Postpago). creditLimit limita la deuda permitida de los Postpago (0 = sin límite).
// Los campos de lealtad (totalVisits/totalSpent/lastVisitAt/points) son una caché
// de métricas para rankings rápidos; la fuente de verdad es Order con paidAt.
model Customer {
  id          String           @id @default(cuid())
  name        String
  ci          String?
  phone       String?
  pensionType PensionType      @default(PREPAGO)
  balance     Int              @default(0)
  creditLimit Int              @default(0)
  totalVisits Int              @default(0)
  totalSpent  Int              @default(0)
  lastVisitAt DateTime?
  points      Int              @default(0)
  createdAt   DateTime         @default(now())
  orders      Order[]
  ledger      CustomerLedger[]
  rewards     CustomerReward[]

  @@index([name])
}

// Regla de lealtad configurable: nivel basado en gasto del mes, visitas del mes
// o puntos acumulados. Al cambiar umbrales no se recalcula el histórico.
model CustomerBenefitRule {
  id          String             @id @default(cuid())
  name        String
  description String
  metric      BenefitMetric      @default(SPEND_MONTH)
  threshold   Int
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  rewards     CustomerReward[]

  @@index([metric, active])
}

// Otorgos y canjes de puntos de lealtad (bitácora de auditoría, patrón análogo
// a CustomerLedger). pointsUsed es siempre positivo; el tipo da el sentido.
model CustomerReward {
  id            String             @id @default(cuid())
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ruleId        String?
  rule          CustomerBenefitRule? @relation(fields: [ruleId], references: [id])
  type          CustomerRewardType
  pointsUsed    Int
  description   String
  redeemedById  String?
  redeemedBy    User?              @relation("CustomerRewardRedeemedBy", fields: [redeemedById], references: [id])
  orderId       String?
  order         Order?             @relation(fields: [orderId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@index([ruleId])
}

// Historial de movimientos de la cuenta. type es un String con los valores
// "RECARGA" (saldo a favor de un Prepago), "PAGO_DEUDA" (abono de un Postpago)
// o "CONSUMO" (compra descontada de la cuenta). amount es siempre positivo;
// el significado lo da el type. paymentMethod solo se registra en abonos
// (RECARGA/PAGO_DEUDA) porque ahí entra efectivo/QR real a la caja.
model CustomerLedger {
  id            String         @id @default(cuid())
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String
  amount        Int
  paymentMethod PaymentMethod?
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Order {
  id             String           @id @default(cuid())
  seq            Int?             @unique
  orderDate      String?
  daySeq         Int?
  status         OrderStatus      @default(RECIBIDO)
  customerName   String?
  deliveryType   DeliveryType?
  notes          String?
  // Reserva: hora pactada de entrega. Mientras scheduledFor esté seteado y
  // reservationConfirmed=false el pedido vive en la pestaña RESERVAS sin
  // activar el reloj de producción; reserveLeadMin es cuántos minutos antes
  // de scheduledFor debe iluminarse la card para avisar/confirmar.
  scheduledFor         DateTime?
  reservationConfirmed Boolean          @default(false)
  reserveLeadMin       Int              @default(30)
  total          Int
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?
  paidAt         DateTime?
  deliveredAt    DateTime?
  items          OrderItem[]
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  paymentMethod  PaymentMethod?
  paymentMethod2 PaymentMethod?
  paymentAmount2 Int?
  discountAmount Int              @default(0)
  discountReason String?
  discountedAt   DateTime?
  discountedById String?
  discountedBy   User?            @relation("OrderDiscountedBy", fields: [discountedById], references: [id])
  cancelledAt    DateTime?
  cancelReason   String?
  canceledById   String?
  canceledBy     User?            @relation("OrderCanceledBy", fields: [canceledById], references: [id])
  delayNotified  Boolean          @default(false)
  tiempoEstimado Int              @default(10)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  ledgerEntries  CustomerLedger[]
  customerRewards CustomerReward[]

  @@unique([orderDate, daySeq])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([status, createdAt])
  @@index([deliveredAt])
  @@index([userId])
  @@index([userId, status])
  @@index([customerId])
}

model OrderItem {
  id                 String             @id @default(cuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sizeName           String?
  flavorName         String?
  flavorCategory     FlavorCategory?
  bobaTypeName       String?
  menuItemName       String?
  menuItemCategory   MenuCategory?
  menuItemOptionName String?
  menuItemDetail     String?
  unitPrice          Int
  quantity           Int
  tiempoProduccion   Int                @default(5)
  toppings           OrderItemTopping[]

  @@index([orderId])
}

model OrderItemTopping {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingName String
  unitPrice   Int
}

model PaymentConfig {
  id        String   @id @default("default")
  qrImage   String
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Configuración de la impresora de comandas (registro único, id = "default").
// driver "windows"     -> imprimir en una impresora instalada en Windows.
// driver "virtual-png" -> guardar el ticket como imagen PNG (desarrollo/auditoría).
// outputPath es relativo a la raíz del monorepo (ej. "./tickets-output").
model PrinterConfig {
  id           String   @id @default("default")
  driver       String   @default("windows")
  printerName  String?
  outputPath   String   @default("./tickets-output")
  paperWidthMm Int      @default(80)
  updatedAt    DateTime @updatedAt
}

// Cantidad diaria de un plato del Menú del Día: una fila por (plato, jornada).
// `planned` es lo que la cocina prepara (null = nadie lo programó todavía) y
// `lowThreshold` el aviso de stock bajo, ajustable por plato y día. El vendido
// NO se guarda: se deriva de los pedidos no anulados de la jornada, así que
// remaining = planned + Σ LunchAdjust.delta − sold nunca se desincroniza y
// anular un pedido lo restituye solo.
model LunchQuota {
  id           String   @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  // Día local YYYY-MM-DD en America/La_Paz (zonedDateKey).
  date         String
  planned      Int?
  lowThreshold Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  adjusts      LunchAdjust[]

  @@unique([menuItemId, date])
  @@index([date])
}

// Bitácora de correcciones manuales sobre la cantidad de una jornada: el delta
// aplicado, la nota del motivo, quién lo hizo y cuándo.
model LunchAdjust {
  id        String    @id @default(cuid())
  quotaId   String
  quota     LunchQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  delta     Int
  note      String?
  userId    String
  createdAt DateTime @default(now())

  @@index([quotaId])
}

// Apartado de cupo mientras el almuerzo esta en el ticket en curso: una fila por
// (menuItemId, date, cartId). Impide que otra terminal venda lo que esta caja ya
//prometio. expiresAt libera el cupo si la caja abandona el ticket.
model LunchHold {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  date       String
  cartId     String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@unique([menuItemId, date, cartId])
  @@index([date])
  @@index([cartId])
  @@index([expiresAt])
}

model DailyReportLog {
  // Día (YYYY-MM-DD) cuyo cierre de caja ya se envió a Telegram.
  date   String   @id
  sentAt DateTime @default(now())
}

// Cierre de caja: arqueo físico de efectivo por denominación y contraste con
// lo registrado en el sistema (ventas + recargas de pensionados). Puede haber
// varios cierres al día (ej. un turno de mañana y otro de tarde): cada uno
// guarda su histórico con fecha, hora y cajero para auditoría y reimpresión.
model CashClose {
  id            String   @id @default(cuid())
  // Día local (YYYY-MM-DD) que se está cerrando.
  date          String
  closedAt      DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  // Desglose del efectivo contado por denominación: JSON con pares
  // [["200",2],["100",3],...], en Bs. countedCash = Σ valor × cantidad.
  denominations String
  countedCash   Float
  // Contrastes calculados por el sistema (los pagos divididos ya quedaron
  // prorrateados entre sus métodos).
  systemCash    Float
  systemQr      Float
  systemCard    Float
  // Consumos del día cobrados a cuenta de pensionados (NO entran a la caja).
  pensionSales  Float
  // Recargas/pagos de deuda de pensionados (SÍ entran a la caja ese día).
  rechargeCash  Float
  rechargeQr    Float
  // sobranate/faltante de efectivo = countedCash - systemCash (systemCash ya
  // incluye rechargeCash).
  diffCash      Float
  notes         String?
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([closedAt])
}

enum FlavorCategory {
  MILK
  WATER
  SPECIAL
}

enum MenuCategory {
  ALMUERZO
  SANDWICH
  PANINI
  ENSALADA
  PIQUEO
  COMPARTIR
  ALITA
  HAMBURGUESA
  MILANESA
  LOMO
  POLLO
  KIDS
  POSTRE
  WAFFLE
  PANCAKE
  EXTRAS
  BEBIDA
}

enum BobaKind {
  TAPIOCA
  POPPING
}

enum OrderStatus {
  RECIBIDO
  ACEPTADO
  ENTREGADO
  ANULADO
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CAJERO
  MESERO
}

enum Shift {
  MANANA
  TARDE
  SIN_TURNO
}

enum PaymentMethod {
  EFECTIVO
  QR
  TARJETA
  PENSION
}

enum PensionType {
  PREPAGO
  POSTPAGO
}

enum DeliveryType {
  MESA
  LLEVAR
  DELIVERY
}

// Métrica que dispara un nivel de lealtad: gasto del mes, visitas del mes o
// puntos acumulados.
enum BenefitMetric {
  SPEND_MONTH
  VISITS_MONTH
  POINTS
}

// Tipo de registro de Reward en la bitácora de lealtad.
enum CustomerRewardType {
  OTORGADO
  CANJE
}
