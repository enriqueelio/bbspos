generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  role      Role     @default(CAJERO)
  shift     Shift    @default(SIN_TURNO)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
  cancelledOrders Order[] @relation("OrderCanceledBy")
  discountedOrders Order[] @relation("OrderDiscountedBy")
}

model Size {
  id         String   @id @default(cuid())
  name       String   @unique
  oz         Int
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  drinkPrices DrinkPrice[]
}

model Flavor {
  id         String               @id @default(cuid())
  name       String               @unique
  categories FlavorCategoryLink[]
  available  Boolean              @default(true)
  createdAt  DateTime             @default(now())
}

model FlavorCategoryLink {
  id       String        @id @default(cuid())
  flavorId String
  flavor   Flavor        @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  category FlavorCategory
  createdAt DateTime     @default(now())

  @@unique([flavorId, category])
}

model BobaType {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      BobaKind
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  drinkPrices DrinkPrice[]
}

model DrinkPrice {
  id         String        @id @default(cuid())
  category   FlavorCategory
  sizeId     String
  size       Size          @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  bobaTypeId String
  bobaType   BobaType      @relation(fields: [bobaTypeId], references: [id], onDelete: Cascade)
  price      Int
  createdAt  DateTime      @default(now())

  @@unique([category, sizeId, bobaTypeId])
}

model Topping {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int
  available Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MenuItem {
  id             String            @id @default(cuid())
  name           String
  category       MenuCategory      @default(ALMUERZO)
  price          Int
  description    String?
  available      Boolean           @default(true)
  enMenuDelDia   Boolean           @default(false)
  menuDelDiaDate String?
  options        MenuItemOption[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([category, available])
}

// Opciones de un platillo con variantes de precio obligatorias, p. ej. las
// milanesas "a la carta" que se cobra distinto Pollo vs Res.
model MenuItemOption {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  createdAt  DateTime @default(now())

  @@unique([menuItemId, name])
}

model Order {
  id             String         @id @default(cuid())
  seq            Int?           @unique
  status         OrderStatus    @default(RECIBIDO)
  customerName   String?
  deliveryType   DeliveryType?
  total          Int
  createdAt      DateTime       @default(now())
  paidAt         DateTime?
  deliveredAt    DateTime?
  items          OrderItem[]
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  paymentMethod  PaymentMethod?
  paymentMethod2 PaymentMethod?
  paymentAmount2 Int?
  discountAmount Int            @default(0)
  discountReason String?
  discountedAt   DateTime?
  discountedById String?
  discountedBy   User?          @relation("OrderDiscountedBy", fields: [discountedById], references: [id])
  cancelledAt    DateTime?
  cancelReason   String?
  canceledById   String?
  canceledBy     User?          @relation("OrderCanceledBy", fields: [canceledById], references: [id])
  delayNotified  Boolean        @default(false)

  @@index([createdAt])
  @@index([createdAt, status])
  @@index([status, createdAt])
  @@index([deliveredAt])
  @@index([userId])
  @@index([userId, status])
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sizeName         String?
  flavorName       String?
  flavorCategory   FlavorCategory?
  bobaTypeName     String?
  menuItemName     String?
  menuItemCategory MenuCategory?
  menuItemOptionName String?
  unitPrice        Int
  quantity         Int
  toppings         OrderItemTopping[]

  @@index([orderId])
}

model OrderItemTopping {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingName String
  unitPrice   Int
}

model PaymentConfig {
  id        String   @id @default("default")
  qrImage   String
  mimeType  String
  updatedAt DateTime @updatedAt
}

model DailyReportLog {
  // Día (YYYY-MM-DD) cuyo cierre de caja ya se envió a Telegram.
  date   String   @id
  sentAt DateTime @default(now())
}

enum FlavorCategory {
  MILK
  WATER
  SPECIAL
}

enum MenuCategory {
  ALMUERZO
  SANDWICH
  PANINI
  ENSALADA
  PIQUEO
  COMPARTIR
  ALITA
  HAMBURGUESA
  MILANESA
  LOMO
  POLLO
  KIDS
  POSTRE
  WAFFLE
  PANCAKE
  EXTRAS
  BEBIDA
}

enum BobaKind {
  TAPIOCA
  POPPING
}

enum OrderStatus {
  RECIBIDO
  ACEPTADO
  ENTREGADO
  ANULADO
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CAJERO
  MESERO
}

enum Shift {
  MANANA
  TARDE
  SIN_TURNO
}

enum PaymentMethod {
  EFECTIVO
  QR
  TARJETA
}

enum DeliveryType {
  MESA
  LLEVAR
}
